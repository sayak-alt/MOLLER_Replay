# Independent shower-max electronics (same defaults as MD)
store_waveforms_showermax 1
gatewidth_showermax 400
dt_showermax 4
nbits_showermax 12
vrange_showermax 1
R_showermax 50
ped_showermax 300
pedsigma_showermax 5
trigoffset_showermax 30
sigmatime_showermax 1
tau_showermax 10
Qpe_showermax 1.6e-13

# Shower-max response settings; enable using detectors_list
 lut_directory_showermax showermax_tables
 calibration_file_showermax SM_channel_calibration.csv
 legacy_pion_names_showermax 1
 detector_map_showermax MOLLER_showermax_electronics_map.csv
 readout_all_channels_showermax 1

detector_map_mollerpmt MOLLER_detector_electronics_map.csv
calibration_file_mollerpmt MD_channel_calibration.csv
readout_all_channels_mollerpmt 1
# PE response: 0 = existing Frank-Tamm, 1 = lookup tables
pe_method_mollerpmt 0
lut_directory_mollerpmt look_up_table
lut_ring_mollerpmt 0


#TS parameters

# Trigger scintillator PE response
ts_det_ids 400 401 402 403 404 405 406 407 408 409 410 411 412 413
ts_pe_per_mev 125

ts_enable_electronics 1
ts_readout_all_channels 1
ts_store_waveforms 1
ts_store_pe_times 0

ts_calibration_file TS_channel_calibration.csv
ts_detector_map_file MOLLER_trigscint_electronics_map.csv

ts_scint_decay_ns 2.1
ts_pulse_tau_ns 10
ts_sigma_time_ns 1
ts_transit_time_ns 0
ts_hit_time_mode 0



#Random seed
Rseed 0
#global trigger jitter for all detectors in ns
TriggerJitter 3.0 
#list of detectors to digitize
#detectors_list hcal bbps bbsh grinch bbhodo mollergem 
#detectors_list mollergem mollerpmt
 detectors_list mollerpmt showermax trigscint

store_waveforms_mollerpmt 1

gatewidth_mollerpmt 400
dt_mollerpmt 4.0
nbits_mollerpmt 12
vrange_mollerpmt 1.0
R_mollerpmt 50.0

ped_mollerpmt 300
pedsigma_mollerpmt 5.0
trigoffset_mollerpmt 30.0
sigmatime_mollerpmt 1.0
tau_mollerpmt 10.0
Qpe_mollerpmt 1.6e-13

nquartz_mollerpmt 1.47
beta_mollerpmt 1.0
lambda_min_mollerpmt 200
lambda_max_mollerpmt 600
eps_photon_to_pe_mollerpmt 0.03
dEdx_mollerpmt 4.0

