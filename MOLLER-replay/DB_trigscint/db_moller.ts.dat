# TS waveform replay. These electronics values must match digitizer metadata.
# No injected pedestal, gain, PE or hit time is used to reconstruct pulses.
moller.ts.nchannels = 14
moller.ts.nsamples = 100
moller.ts.baseline_samples = 10
moller.ts.NSB = 5
moller.ts.NSA = 22
moller.ts.dt_ns = 4
moller.ts.gate_start_ns = -170
moller.ts.range_v = 1
moller.ts.resistance_ohm = 50
moller.ts.bits = 12
moller.ts.threshold_adc = 20.48
moller.ts.threshold_sigma = 5
# 0 peak, 1 interpolated detection threshold, 2 rising half-height.
moller.ts.timing_reference = 2
# 0 peak anchor, 1 first sample above threshold.
moller.ts.integration_reference = 1
# Actual consecutive sample count, not NSAT register encoding.
moller.ts.threshold_samples = 1
# detid ROC slot channel plane sector. Simulation addresses, not measured wiring.
moller.ts.channel_map =
 400 3 3 0 0 1
 401 3 3 1 0 2
 402 3 3 2 0 3
 403 3 3 3 0 4
 404 3 3 4 0 5
 405 3 3 5 0 6
 406 3 3 6 0 7
 407 3 3 7 1 1
 408 3 3 8 1 2
 409 3 3 9 1 3
 410 3 3 10 1 4
 411 3 3 11 1 5
 412 3 3 12 1 6
 413 3 3 13 1 7
