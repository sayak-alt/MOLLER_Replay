# MOLLER MD mock-data replay database. Values must match digitiser electronics.
# Simulation PMT gains/pedestals stay in the digitiser calibration CSV.
# Replay estimates baseline/noise from waveform samples, without truth constants.
moller.md.nchannels = 224
moller.md.nsamples = 100
moller.md.baseline_samples = 10
moller.md.NSB = 5
moller.md.NSA = 22
moller.md.dt_ns = 4
moller.md.gate_start_ns = -170
moller.md.range_v = 1
moller.md.resistance_ohm = 50
moller.md.bits = 12
moller.md.threshold_adc = 20.48
moller.md.threshold_sigma = 5

# Four integers per row: detector ID, ROC, slot, channel.
# Rows sorted by segment, ring and detector ID. All 224 channels enabled.
moller.md.channel_map =
