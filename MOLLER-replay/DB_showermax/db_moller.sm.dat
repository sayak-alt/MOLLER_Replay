# MOLLER Shower-Max sparse-data replay database. Values must match digitiser electronics.
# Simulation truth stays in showermax_digi; no truth used to reconstruct pulses.
# Replay estimates baseline/noise from waveform samples, without truth constants.
moller.sm.nchannels = 28
moller.sm.nsamples = 100
moller.sm.baseline_samples = 10
moller.sm.NSB = 5
moller.sm.NSA = 22
moller.sm.dt_ns = 4
moller.sm.gate_start_ns = -170
moller.sm.range_v = 1
moller.sm.resistance_ohm = 50
moller.sm.bits = 12
moller.sm.threshold_adc = 20.48
moller.sm.threshold_sigma = 5

# Software timing/integration selectors; defaults preserve previous charge extraction.
# time_ns: 0=peak, 1=interpolated threshold, 2=interpolated half-height.
moller.sm.timing_reference = 2
# Integration anchor: 0=peak, 1=first sample above threshold (TC).
moller.sm.integration_reference = 1
# Actual consecutive sample count, NOT the hardware NSAT register encoding.
moller.sm.threshold_samples = 1


# detid ROC slot channel; must agree with the companion CSV
moller.sm.channel_map =
